{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/usamaizm/AIID/blob/main/schema/aiid-0.1.schema.json",
  "title": "AIID Descriptor 0.1",
  "description": "Provisional JSON Schema for AIID draft 0.1. The $id identifies the versioned schema published in this repository.",
  "type": "object",
  "required": [
    "aiid_version",
    "identity"
  ],
  "properties": {
    "aiid_version": {
      "const": "0.1"
    },
    "identity": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "scheme": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "resource": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "description": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "integrity": {
      "type": "object"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
